PROJECT_NAME="Smart Mine Subsidence Monitoring & Early Warning Platform"
ORGANIZATION="Ministry of Coal, Government of India"

# Database
# For local development: SQLite is used by default if DATABASE_URL is not set
DATABASE_URL=sqlite:///./mine_subsidence.db

# Security
SECRET_KEY=sih-2026-coal-india-mine-subsidence-secret-key-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# EMAIL NOTIFICATION CONFIGURATION (SMTP)
# ==============================================================================
# To enable actual email delivery for DGMS statutory notices & emergency alerts:
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASSWORD=your_16_char_google_app_password
#   SMTP_FROM_EMAIL=your_email@gmail.com
#   SMTP_TLS=True
#   SMTP_SSL=False
# For Outlook / Office365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
# For Custom / Gov SMTP Relay:
#   SMTP_HOST=mail.secl.gov.in
#   SMTP_PORT=465 (with SMTP_SSL=True) or 587 (with SMTP_TLS=True)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Mine Subsidence Early Warning System (SECL/DGMS)"
SMTP_TLS=True
SMTP_SSL=False

# ==============================================================================
# SMS NOTIFICATION CONFIGURATION
# ==============================================================================
# Option 1: Twilio SMS (International & India)
#   Sign up at twilio.com, obtain Account SID, Auth Token, and Virtual Phone Number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Option 2: Fast2SMS (Indian SMS Gateway)
#   Sign up at fast2sms.com, obtain API Authorization Key.
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=

# Option 3: Custom SMS Webhook / CDAC Gateway
#   POST endpoint that accepts JSON {"to": "+91...", "message": "..."}
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
