PROJECT_NAME="Smart Mine Subsidence Monitoring & Early Warning Platform"
ORGANIZATION="Ministry of Coal, Government of India"

# Database
# For local development: uses SQLite by default if not set
# For production (Supabase or Docker PostgreSQL): set this to your connection string
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./mine_subsidence.db

# Supabase (optional — only needed if using Supabase client SDK features)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_KEY=your-service-role-key

# Security — CHANGE THIS in production! Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — comma-separated list of allowed frontend origins (no wildcards in production)
# BACKEND_CORS_ORIGINS=https://yourfrontend.vercel.app,https://yourapp.com

# MQTT (optional sensor hardware integration)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_ENABLED=false
